{
  "title": "PerfAgent LLMOps",
  "tags": ["perfagent", "llm", "ai-observability"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total LLM Calls (last hour)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(perfagent_llm_calls_total[1h])) * 3600", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "P90 Latency",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.9, rate(perfagent_llm_latency_ms_bucket[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{ "color": "green" }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 15000 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Total Cost (USD)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(perfagent_llm_cost_usd_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 4, "type": "stat", "title": "Parse Success Rate",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(perfagent_llm_calls_total{parse_success=\"true\"}[5m])) / sum(rate(perfagent_llm_calls_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.85 }, { "color": "green", "value": 0.95 }] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "LLM Latency by Skill (P90)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.9, sum(rate(perfagent_llm_latency_ms_bucket[5m])) by (le, skill))",
        "legendFormat": "{{skill}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Tokens by Skill",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(perfagent_llm_tokens_total[5m])) by (skill)",
        "legendFormat": "{{skill}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Findings by Severity",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(perfagent_findings_total[5m])) by (severity)",
        "legendFormat": "{{severity}}", "refId": "A" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "RAG Retrieval Latency",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(perfagent_rag_latency_ms_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.9, rate(perfagent_rag_latency_ms_bucket[5m]))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(perfagent_rag_latency_ms_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
