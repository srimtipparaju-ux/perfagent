# ─── REQUIRED ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── OPTIONAL: Model selection ──
ANTHROPIC_MODEL=claude-sonnet-4-5
SKILL_CONCURRENCY=4

# ─── OPTIONAL: RAG (recommended for production) ──
# If unset, falls back to in-memory cosine similarity
PINECONE_API_KEY=
PINECONE_INDEX=perfagent-runbooks
OPENAI_API_KEY=                    # for embeddings (text-embedding-3-small)
RAG_ENABLED=true                   # set to false to disable RAG entirely

# ─── OPTIONAL: Notification integrations ──
SLACK_BOT_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Server config ──
PORT=3000
UPLOAD_DIR=/tmp/perf-agent/uploads
LOG_LEVEL=info
