{
  "name": "perf-agent",
  "version": "1.0.0",
  "description": "AI performance diagnostic agent \u2014 analyzes AWR, thread dumps, heap dumps, JFR, SQL, UI logs, and stack traces. Routes findings to Slack, Jira, and email.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest",
    "deploy:aws": "npm run build && ./deploy/aws-deploy.sh",
    "deploy:docker": "docker build -t perf-agent . && docker run -p 3000:3000 perf-agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.0",
    "form-data": "^4.0.0",
    "nodemailer": "^6.9.7",
    "archiver": "^6.0.1",
    "p-limit": "^5.0.0",
    "@pinecone-database/pinecone": "^2.2.0",
    "openai": "^4.28.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/nodemailer": "^6.4.14",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.10"
  }
}